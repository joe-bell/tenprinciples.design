{
  "name": "tenprinciples.design",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "pnpm build:css && pnpm astro check && astro build",
    "build:css": "pnpm tailwind --minify",
    "dev": "pnpm build:css && pnpm run '/^dev:.*/'",
    "dev:astro": "astro dev",
    "dev:css": "pnpm tailwind --watch",
    "prepare": "pnpm run '/^prepare:.*/'",
    "prepare:hooks": "git config core.hooksPath .github/hooks",
    "prettier": "prettier --config .prettierrc.json --ignore-unknown --no-error-on-unmatched-pattern",
    "preview": "astro preview",
    "start": "astro dev",
    "tailwind": "tailwindcss -i ./src/styles/input.css -o ./src/styles/output.css"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@plausible-analytics/tracker": "0.4.7",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "14.4.8",
    "@astrojs/ts-plugin": "1.11.0",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/cli": "4.3.5",
    "@types/node": "26.6.6",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-packagejson": "3.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "wrangler": "4.162.0"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "24"
  }
}
